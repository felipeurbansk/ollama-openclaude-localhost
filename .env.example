# Modelo a ser baixado e usado pelo Ollama
# Use a variante "tools" para suporte correto a tool calling com Claude Code
# Variante 7b: mais rápida, recomendada para hardware com menos VRAM
# Variante 14b: mais capaz, requer mais de 10GB de VRAM
OLLAMA_PULL_MODEL=hhao/qwen2.5-coder-tools:7b

# Modelo exposto ao Claude Code via OpenAI-compatible API (deve coincidir com OLLAMA_PULL_MODEL)
OPENAI_MODEL=hhao/qwen2.5-coder-tools:7b
