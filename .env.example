# Model pulled on first start when missing (see .devcontainer/docker-entrypoint.sh).
OLLAMA_PULL_MODEL=qwen2.5-coder:7b

# Optional: passed through to the Ollama server process (same names as upstream Ollama).
# OLLAMA_KEEP_ALIVE=30m
# OLLAMA_NUM_PARALLEL=2
# OLLAMA_VULKAN=1

# GPU: devcontainer.json uses --gpus=all (NVIDIA). Host needs a working NVIDIA driver
# plus nvidia-container-toolkit on Linux, or Docker Desktop with WSL2 GPU enabled on Windows.
# If the container fails to start, remove --gpus=all from runArgs to fall back to CPU only.
